function confirmModal(title,text,ok='Confirm'){return new Promise(res=>{$('#modalTitle').textContent=title;$('#modalText').textContent=text;$('#modalOk').textContent=ok;$('#modal').hidden=false;$('#modalOk').onclick=()=>{$('#modal').hidden=true;res(true)};$('#modalCancel').onclick=()=>{$('#modal').hidden=true;res(false)}})}
function switchTab(n){document.querySelectorAll('.tabs button').forEach(b=>b.classList.toggle('active',b.dataset.tab==n));$('#objectPane').hidden=n!='object';$('#dataPane').hidden=n!='data';$('#knotPane').hidden=n!='knot';if(n=='knot')renderKnot()}
function renderAssets(){ $('#assets').innerHTML=ART.map(a=>`<article class="asset"><img src="${a[2]}" alt="${a[1]}"><div><strong>${a[1]}</strong><small>Unsplash reference<br>Creator: ${a[3]} · Verify license</small><button data-art="${a[0]}" style="margin-top:8px;font-size:10px">Use reference</button></div></article>`).join('');document.querySelectorAll('[data-art]').forEach(b=>b.onclick=()=>{if(!object())return;object().art=b.dataset.art;save('Art reference attached');render()})}
function renderScenes(){let s=scene();$('#scenes').innerHTML=state.scenes.map(x=>`<button class="item ${x.id==s.id?'active':''}" data-scene="${x.id}"><span class="item-name">${esc(x.title)}</span><small>${x.objects.length} obj</small></button>`).join('');document.querySelectorAll('[data-scene]').forEach(b=>b.onclick=()=>{state.activeScene=b.dataset.scene;let c=scene();state.activeEntry=c.objects[0]?.id||null;state.activeObject=c.objects[0]?.oid||null;save('Scene loaded');rebuildScene()});$('#sceneTitle').value=s.title;$('#sceneNotes').value=s.notes;$('#biome').value=s.biome;$('#objCount').textContent=s.objects.length+' placed'}
function renderLibrary(){let s=scene();$('#library').innerHTML=state.objects.map(o=>`<button class="item ${o.id==state.activeObject?'active':''}" data-obj="${o.id}"><span class="item-left"><i class="swatch" style="background:${o.color}"></i><span class="item-name">${esc(o.name)}</span></span><small>${s.objects.some(e=>e.oid==o.id)?'IN SCENE':o.kind}</small></button>`).join('');document.querySelectorAll('[data-obj]').forEach(b=>b.onclick=()=>{state.activeObject=b.dataset.obj;let e=s.objects.find(x=>x.oid==state.activeObject);state.activeEntry=e?.id||null;switchTab('data');render()})}
function renderObjects(){let s=scene();$('#sceneObjects').innerHTML=s.objects.map((e,i)=>{let o=state.objects.find(x=>x.id==e.oid);if(!o)return'';return`<button class="item ${e.id==state.activeEntry?'active':''}" data-entry="${e.id}"><span class="item-left"><i class="swatch" style="background:${o.color}"></i><span><span class="item-name">${i+1}. ${esc(o.name)}</span><br><small>(${e.x.toFixed?.(1)||e.x}, ${e.z.toFixed?.(1)||e.z})</small></span></span><small>× ${e.scale||1}</small></button>`}).join('')||'<div class="empty">No objects placed yet.</div>';document.querySelectorAll('[data-entry]').forEach(b=>b.onclick=()=>{state.activeEntry=b.dataset.entry;let e=entry();state.activeObject=e.oid;switchTab('data');render()})}
function renderEditor(){let o=object(),e=entry(),s=scene();if(!o){$('#objectEditor').innerHTML='<div class="empty">Select an object.</div>';return}let targets=s.objects.filter(x=>x.id!=e?.id);$('#objectEditor').innerHTML=`${e?`<div class="card transform"><h3>Scene Instance</h3><div class="grid3"><label class="mini">X<input id="ix" type="number" value="${e.x}"></label><label class="mini">Y<input id="iy" type="number" value="${e.y||0}"></label><label class="mini">Z<input id="iz" type="number" value="${e.z}"></label></div><div class="grid2" style="margin-top:8px"><label class="mini">Rotation<input id="ir" type="number" value="${e.ry||0}"></label><label class="mini">Scale<input id="is" type="number" min=".1" max="10" step=".1" value="${e.scale||1}"></label></div><button id="removeEntry" class="danger" style="margin-top:8px;width:100%">Remove instance</button></div><div class="card"><h3>Rebus Links</h3>${targets.length?`<div class="row"><select id="target">${targets.map(t=>{let oo=state.objects.find(z=>z.id==t.oid);return`<option value="${t.id}">${esc(oo.name)}</option>`}).join('')}</select><select id="relation"><option>guides_to</option><option>resonates_with</option><option>supports</option><option>guards</option><option>powers</option></select><button id="link" class="primary">Link</button></div>`:'<p class="empty">Place another object to link it.</p>'}</div>`:''}<div class="field"><label>Name</label><input id="oname" value="${esc(o.name)}"></div><div class="grid2"><div class="field"><label>Kind</label><select id="okind"><option ${o.kind=='character'?'selected':''}>character</option><option ${o.kind=='foliage'?'selected':''}>foliage</option><option ${o.kind=='prop'?'selected':''}>prop</option><option ${o.kind=='landmark'?'selected':''}>landmark</option><option ${o.kind=='structure'?'selected':''}>structure</option></select></div><div class="field"><label>Color</label><input id="ocolor" type="color" value="${o.color}"></div></div><div class="field"><label>Creator / provenance</label><input id="ocreator" value="${esc(o.creator||'')}"></div><div class="field"><label>Description</label><input id="odesc" value="${esc(o.description||'')}"></div><div class="field"><label>License</label><input id="olicense" value="${esc(o.license||'')}"></div><button id="deleteObj" class="danger" style="width:100%">Delete global object</button>`;
['oname','okind','ocolor','ocreator','odesc','olicense'].forEach(id=>$('#'+id).onchange=e=>{let prop={oname:'name',okind:'kind',ocolor:'color',ocreator:'creator',odesc:'description',olicense:'license'}[id];o[prop]=e.target.value;if(id=='odesc'||id=='oname'||id=='okind'){let p=parse(o.name+' '+o.description);o.kind=p.kind;o.tags=[p.kind]}save('Metadata re-woven');rebuildScene()});['ix','iy','iz','ir','is'].forEach(id=>$('#'+id)?.addEventListener('change',()=>{if(!e)return;e.x=+($('#ix')?.value||0);e.y=+($('#iy')?.value||0);e.z=+($('#iz')?.value||0);e.ry=+($('#ir')?.value||0);e.scale=Math.max(.1,+($('#is')?.value||1));save('Transform updated');rebuildScene()}));$('#removeEntry')?.addEventListener('click',()=>{s.objects=s.objects.filter(x=>x.id!=e.id);s.knots=s.knots.filter(k=>k.a!=e.id&&k.b!=e.id);state.activeEntry=s.objects[0]?.id||null;save('Instance removed');rebuildScene()});$('#link')?.addEventListener('click',()=>{s.knots.push({id:uid(),a:e.id,b:$('#target').value,r:$('#relation').value});save('Rebus knot linked');rebuild();render()});$('#deleteObj')?.addEventListener('click',async()=>{if(await confirmModal('Delete global object?','This removes the object and all linked instances.','Delete object')){let ids=new Set(s.objects.filter(x=>x.oid==o.id).map(x=>x.id));state.objects=state.objects.filter(x=>x.id!=o.id);state.scenes.forEach(sc=>{sc.objects=sc.objects.filter(x=>x.oid!=o.id);sc.knots=sc.knots.filter(k=>!ids.has(k.a)&&!ids.has(k.b))});state.activeObject=state.objects[0]?.id||null;save('Global object deleted');rebuildScene()}})}
function renderKnot(){let s=scene(),o=object();let p=o?parse(o.name+' '+o.description):null;$('#knotInspector').innerHTML=`<div class="card"><h3>Semantic parser</h3><div class="notice">Selected: ${esc(o?.name||'None')}<br>Archetype: ${p?.ar||'—'} · Kind: ${p?.kind||'—'}<br>Floating: ${p?.floating||false} · Rotating: ${p?.rotating||false} · Glowing: ${p?.glowing||false}</div></div><div class="card"><h3>Scene knots (${s.knots.length})</h3>${s.knots.length?s.knots.map(k=>{let a=s.objects.find(x=>x.id==k.a),b=s.objects.find(x=>x.id==k.b),oa=state.objects.find(x=>x.id==a?.oid),ob=state.objects.find(x=>x.id==b?.oid);return`<div class="knot"><span>${esc(oa?.name)} <b>${esc(k.r)}</b> ${esc(ob?.name)}</span><button class="danger" data-rmk="${k.id}">×</button></div>`}).join(''):'<div class="empty">No knot edges yet.</div>'}</div>`;document.querySelectorAll('[data-rmk]').forEach(b=>b.onclick=()=>{s.knots=s.knots.filter(k=>k.id!=b.dataset.rmk);save('Knot removed');rebuild();render()})}
function render(){renderScenes();renderLibrary();renderObjects();renderEditor();renderAssets();if(!$('#knotPane').hidden)renderKnot();$('#toggleKnot').textContent='Knot links: '+(state.showKnots?'ON':'OFF');$('#toggleKnot').classList.toggle('active',state.showKnots);$('#toggleSnap').textContent='Grid snap: '+(state.snap?'ON':'OFF');$('#toggleSnap').classList.toggle('active',state.snap)}
function synthObject(text){let p=parse(text),o={id:uid(),name:text.split(/\s+/).slice(0,3).map(w=>w[0].toUpperCase()+w.slice(1)).join(' ')||'Rebus Object',kind:p.kind,color:p.color,art:'mountains',description:text,creator:'WorldForge Synthesizer',license:'Procedural asset',tags:[p.kind]};state.objects.push(o);state.activeObject=o.id;let s=scene(),e={id:uid(),oid:o.id,x:(s.objects.length%5-2)*2.4,z:Math.floor(s.objects.length/5)*2.4-.6,ry:0,scale:1};s.objects.push(e);state.activeEntry=e.id;switchTab('data');save('Object synthesized');rebuildScene()}
function synthScene(text){let p=parse(text);let biomeKey=/neon|cyber|rain|night/.test(text)?'neon':/desert|dune|sand|dusk/.test(text)?'desert':/forest|moss|druid|grove/.test(text)?'forest':/ice|frost|snow|arctic/.test(text)?'arctic':'alpine';let words=text.split(/\s+/).slice(0,3).map(w=>w[0].toUpperCase()+w.slice(1)).join(' '),coords=[[0,-2.2],[-3.2,1.2],[3.2,1],[0,2.8]],ents=[];for(let i=0;i<4;i++){let sp=parse(text+' '+['core landmark','sentinel guardian','resonant conduit','terrain anchor'][i]),o={id:uid(),name:['Core landmark','Sentinel guardian','Resonant conduit','Terrain anchor'][i],kind:sp.kind,color:sp.color,art:ART[i%4][0],description:text+' — '+['core landmark','sentinel guardian','resonant conduit','terrain anchor'][i],creator:'WorldForge Scene Synthesizer',license:'Procedural scene asset',tags:[sp.kind]};state.objects.push(o);ents.push({id:uid(),oid:o.id,x:coords[i][0],z:coords[i][1],ry:i*30,scale:i==0?1.15:1})}let s={id:uid(),title:words,biome:biomeKey,notes:text,objects:ents,knots:[{id:uid(),a:ents[1].id,b:ents[0].id,r:'guards'},{id:uid(),a:ents[2].id,b:ents[0].id,r:'resonates_with'},{id:uid(),a:ents[3].id,b:ents[0].id,r:'supports'}]};state.scenes.push(s);state.activeScene=s.id;state.activeEntry=ents[0].id;state.activeObject=ents[0].oid;save('Scene synthesized');rebuildScene()}
$('#addScene').onclick=()=>{let s={id:uid(),title:'New Scene '+(state.scenes.length+1),biome:'alpine',notes:'',objects:[],knots:[]};state.scenes.push(s);state.activeScene=s.id;state.activeEntry=null;save('Scene created');rebuildScene()};$('#dupScene').onclick=()=>{let s=scene(),map=new Map(),objs=s.objects.map(e=>{let n={...e,id:uid()};map.set(e.id,n.id);return n}),knots=s.knots.map(k=>({...k,id:uid(),a:map.get(k.a),b:map.get(k.b)})),c={...s,id:uid(),title:s.title+' Copy',objects:objs,knots};state.scenes.push(c);state.activeScene=c.id;state.activeEntry=c.objects[0]?.id||null;save('Scene duplicated');rebuildScene()};$('#sceneTitle').onchange=e=>{scene().title=e.target.value;save('Scene title updated');rebuildScene()};$('#sceneNotes').onchange=e=>{scene().notes=e.target.value;save('Scene notes updated')};$('#biome').onchange=e=>{scene().biome=e.target.value;save('Biome updated');rebuildScene()};$('#synthScene').onclick=()=>{let t=$('#scenePrompt').value.trim();if(t)synthScene(t)};document.querySelectorAll('[data-prompt]').forEach(b=>b.onclick=()=>synthScene(b.dataset.prompt));$('#newObject').onclick=()=>{let o={id:uid(),name:'New Object '+(state.objects.length+1),kind:'prop',color:'#65e0b0',art:'mountains',description:'Reusable global object',creator:'',license:'',tags:['new']};state.objects.push(o);state.activeObject=o.id;state.activeEntry=null;switchTab('data');save('Object created');render()};$('#synthObject').onclick=()=>{let t=$('#objectPrompt').value.trim();if(t){synthObject(t);$('#objectPrompt').value=''}};$('#objectPrompt').onkeydown=e=>{if(e.key=='Enter')$('#synthObject').click()};$('#addSelected').onclick=()=>{let o=object(),s=scene();if(!o)return;let e={id:uid(),oid:o.id,x:((s.objects.length%5)-2)*2.5,z:Math.floor(s.objects.length/5)*2.5,ry:0,scale:1};s.objects.push(e);state.activeEntry=e.id;save('Instance added');rebuildScene()};$('#removeSelected').onclick=()=>{let s=scene(),e=entry();if(!e)return;s.objects=s.objects.filter(x=>x.id!=e.id);s.knots=s.knots.filter(k=>k.a!=e.id&&k.b!=e.id);state.activeEntry=s.objects[0]?.id||null;save('Instance removed');rebuildScene()};$('#toggleKnot').onclick=()=>{state.showKnots=!state.showKnots;rebuild();save('Knot overlay updated');render()};$('#toggleSnap').onclick=()=>{state.snap=!state.snap;biome();save('Grid snap updated');render()};function focus(){let e=entry(),g=e&&meshMap.get(e.id);if(!g)return;controls.target.set(g.position.x,g.position.y+.8,g.position.z);controls.update();save('Camera focused')}$('#focusSelected').onclick=focus;window.addEventListener('keydown',e=>{if(e.key=='f'||e.key=='F')focus()});document.querySelectorAll('.tabs button').forEach(b=>b.onclick=()=>switchTab(b.dataset.tab));$('#export').onclick=()=>{let b=new Blob([JSON.stringify({format:'WorldForge Rebus Knot project',version:2,exportedAt:new Date().toISOString(),...state},null,2)],{type:'application/json'}),u=URL.createObjectURL(b),a=document.createElement('a');a.href=u;a.download='worldforge-rebus-project.json';a.click();URL.revokeObjectURL(u);save('Project exported')};$('#import').onclick=()=>$('#file').click();$('#file').onchange=async e=>{try{let x=JSON.parse(await e.target.files[0].text());if(!x.scenes?.length||!x.objects?.length)throw Error('Invalid project');state=x;save('Project imported');rebuildScene()}catch(err){confirmModal('Import failed',err.message,'Close')}finally{e.target.value=''}};
const clock=new THREE.Clock();function animate(){requestAnimationFrame(animate);let t=clock.getElapsedTime();controls.update();for(let g of meshMap.values()){let p=g.children[0];if(p?.userData.float)p.position.y=.65+Math.sin(t*2+p.position.x)*.13}renderer.render(world,camera)}
rebuildScene();save('WorldForge ready');animate();
</script>
